rules_version = '2';

// Spark-friendly: no Cloud Functions. Keep admin checks in sync with web/src/adminConfig.ts
service cloud.firestore {
  match /databases/{database}/documents {
    function isParkingAdmin() {
      return request.auth != null && (
        request.auth.uid == 'Ayisu6zH1OgqQ4XM9ggk6y1mpxS2' ||
        (request.auth.token.email is string
          && request.auth.token.email.lower() == 'sarveshkum9999@gmail.com')
      );
    }

    function isApprovedStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/app_users/$(request.auth.uid));
    }

    function canUseParking() {
      return isParkingAdmin() || isApprovedStaff();
    }

    // Vehicle doc shape (matches web normalizeVehicle + Android VehicleData). Name may be empty.
    function isVehicle(d) {
      return d.keys().hasOnly(['id', 'entry1', 'entry2', 'entry3', 'entry4', 'addedAt'])
        && d.entry2 is string && d.entry2.size() >= 1 && d.entry2.size() <= 120
        && d.entry1 is string && d.entry1.size() <= 120
        && d.entry3 is string && d.entry3.size() <= 120
        && d.entry4 is string && d.entry4.size() <= 120
        && (!('id' in d) || d.id is int)
        && (!('addedAt' in d) || d.addedAt is timestamp);
    }

    // Access requests: creator must be signed in; requestUid must match their Auth uid (password
    // was set at signup on the same project). Only admin reads/updates.
    match /access_requests/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['email', 'note', 'status', 'createdAt', 'requestUid'])
        && request.resource.data.requestUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 120
        && request.resource.data.status == 'pending'
        && (request.resource.data.note == null
            || (request.resource.data.note is string && request.resource.data.note.size() <= 800));

      allow read, update: if isParkingAdmin();
      allow delete: if false;
    }

    // Staff directory (written when admin approves). Admin full control; user can read own row.
    match /app_users/{uid} {
      allow read: if isParkingAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update, delete: if isParkingAdmin();
    }

    // Vehicle lists (web app; Android APK still targets your_collection / your_collection1).
    match /my_new_collection/{docId} {
      allow read, delete: if canUseParking();
      allow create, update: if canUseParking() && isVehicle(request.resource.data);
    }

    match /my_new_collection_1/{docId} {
      allow read, delete: if canUseParking();
      allow create, update: if canUseParking() && isVehicle(request.resource.data);
    }

    // Daily history written by “Delete all today”. Saints can add; only admin reads / prunes.
    match /parking_history/{id} {
      allow create: if canUseParking()
        && request.resource.data.keys().hasOnly(['day', 'count', 'vehicles', 'clearedAt', 'clearedBy'])
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.count is int
        && request.resource.data.count >= 1 && request.resource.data.count <= 500
        && request.resource.data.vehicles is list
        && request.resource.data.vehicles.size() == request.resource.data.count
        && request.resource.data.clearedAt == request.time
        && (request.resource.data.clearedBy == null
            || request.resource.data.clearedBy == request.auth.uid);
      allow read, delete: if isParkingAdmin();
      allow update: if false;
    }
  }
}
